# Copy to .env. Every value except OPENROUTER_API_KEY works as it is for a local demo.
# Unknown keys are rejected, so a typo fails fast.

# Required for any model call. Use the key provided with the submission, or your own from openrouter.ai.
OPENROUTER_API_KEY=

# Database (docker compose publishes Postgres on 127.0.0.1:55433; change LOM_DB_PORT if that port is taken).
LOM_DB_HOST=127.0.0.1
LOM_DB_PORT=55433
LOM_DB_NAME=lom
# Local development only: these passwords protect a database bound to localhost. Change them for anything shared.
LOM_OWNER_DB_PASSWORD=lom_owner_local
LOM_APP_DB_PASSWORD=lom_app_local
LOM_MCP_DB_PASSWORD=lom_mcp_local

# MCP data server. Local development only: any value of 16 or more characters.
LOM_MCP_HOST=127.0.0.1
LOM_MCP_PORT=8765
LOM_MCP_SHARED_SECRET=local-dev-secret-change-me

# false: demo mode, clock pinned to 2026-10-24 and the stored snapshot only. true: real clock and live feeds.
LOM_LIVE=false

# Models per role, as openrouter:<id>.
LOM_MODEL_ORCHESTRATOR=openrouter:z-ai/glm-5.3
LOM_MODEL_ORCHESTRATOR_FALLBACK=openrouter:deepseek/deepseek-v4.1-flash
LOM_MODEL_INVESTIGATOR=openrouter:deepseek/deepseek-v4.1-flash
LOM_MODEL_INVESTIGATOR_FALLBACK=openrouter:z-ai/glm-5.3
LOM_MODEL_JUDGE=openrouter:qwen/qwen3.7-plus
# deny: only providers that do not collect prompts. allow: any provider (needed only if a model has none that comply).
LOM_PROVIDER_DATA_COLLECTION=deny
